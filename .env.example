NODE_ENV=development
PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Neon pooled URL for the runtime; keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# Neon direct URL for Prisma migrations.
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_MINUTES=15
LOG_LEVEL=info
# Set a specific trusted proxy address/range only if your host requires it; blank disables trust.
TRUST_PROXY=
# Only needed while running owner:setup / owner:recover. Remove afterward.
OWNER_EMAIL=owner@example.com
OWNER_USERNAME=owner
OWNER_NAME=Owner
OWNER_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
# Later phases; never expose these through NEXT_PUBLIC_*.
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
